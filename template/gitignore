.env
.agentpress.lock
# Only exists while a scaffold is unfinished (resume reads it, completion deletes it).
.agentpress-pending.json
# wp-config.php holds the same DB credentials .env does — pushing a scaffolded
# site to your own repo must not leak either.
/public/wp-config.php
/public/wp-content/uploads/
/public/wp-content/upgrade/
# Commercial plugin code (Oxygen/Breakdance) shouldn't land in public repos.
/public/wp-content/plugins/oxygen*/
/public/wp-content/plugins/breakdance*/
*.log
node_modules/
# Playwright MCP screenshots and page snapshots. Sites wired by v1.7.1+ send
# these to a temp directory instead, but a site wired before that keeps writing
# them here until `agentpress rewire` is run in it.
.playwright-mcp/
